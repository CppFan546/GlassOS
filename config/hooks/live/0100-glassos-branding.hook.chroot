#!/bin/sh
set -e

# Select a graphical Plymouth theme when the Debian spinner theme is available.
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
  plymouth-set-default-theme spinner || true
fi

# Make Firefox the preferred browser for newly created user accounts.
if command -v update-alternatives >/dev/null 2>&1 && [ -x /usr/bin/firefox-esr ]; then
  update-alternatives --set x-www-browser /usr/bin/firefox-esr || true
fi

# Cairo-Dock is started automatically for the live user's graphical session.
install -d -m 0755 /etc/skel/.config/autostart
cat > /etc/skel/.config/autostart/glassos-dock.desktop <<'EOF'
[Desktop Entry]
Type=Application
Name=GlassOS Dock
Comment=GlassOS floating application dock
Exec=cairo-dock
OnlyShowIn=KDE;
X-KDE-autostart-after=panel
EOF

# Prefer the Breeze dark color scheme for the default live user.
install -d -m 0755 /etc/skel/.config
cat > /etc/skel/.config/kdeglobals <<'EOF'
[General]
ColorScheme=BreezeDark
Name=GlassOS

[Icons]
Theme=Papirus-Dark
EOF

exit 0
